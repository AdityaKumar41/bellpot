# Environment used by the server, the cron jobs and the tools. Everything here has a default; this file documents
# the knobs and is never loaded automatically (pm2/cron set what they need). Secrets stay in secrets/, never here.

# --- network -------------------------------------------------------------------------------------------------------
CLUSTER=devnet                       # localnet | devnet | mainnet
CLUSTER_RPC=https://api.devnet.solana.com
PORT=5041
SITE_URL=https://devnet.sharepot.xyz

# --- paths ---------------------------------------------------------------------------------------------------------
DATA_DIR=./data                      # markets, settlements, evidence, ticks
SHAREPOT_SECRETS=./secrets/devnet    # state.json + proposer/faucet keypairs
STATIC_DIR=./apps/web/dist           # unused by the Next.js site; only if this process still serves files

# --- faucet (test networks) ----------------------------------------------------------------------------------------
FAUCET_RPC=
FAUCET_KEYPAIR=
FAUCET_SOL=0.01
FAUCET_FUND_SOL=0.5
FAUCET_DAILY_GLOBAL=200
FAUCET_DISABLED=0

# --- market opening / settlement -----------------------------------------------------------------------------------
STOCKS=                              # override apps/server/src/stock-templates.json
SEED_MARKETS=0
OVERDUE_SECS=7200
DRY_RUN=0
NOW=
BOUNDARY_PPM=
MIN_CLOSE_SAMPLES=40
SECOND_SOURCE_GRACE_SECS=7200
PRICE_SOURCE=yahoo                   # yahoo | alpaca
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_ENV_FILE=

# --- on-chain token selection (memes) ------------------------------------------------------------------------------
TOKENS_API=
TOKENS_FILE=
GT_PAGES=
MIN_LIQUIDITY_USD=500000
MIN_AGE_DAYS=3

# --- payer / verification keys -------------------------------------------------------------------------------------
PROPOSER_PUBKEY=
ADMIN_KEYPAIR=
ADMIN_FINALIZE=0
TREASURY_KEYPAIR=
REBATE_KEY_FILE=
REBATE_KEYPAIR=
REBATE_MAX_RUN_USD=2000
REBATE_OPEN_ACCOUNT_USD=10
REFERRAL_MIN_USD=
REFERRALS_FILE=
VOID_UNVERIFIED=0

# --- treasury swaps (mainnet) --------------------------------------------------------------------------------------
MAX_IMPACT_PCT=
SLIPPAGE_BPS=
SWAP_MIN_USD=
MAX_SWAP_LAMPORTS=
JITO_URL=
JITO_TIP_MIN=
JITO_TIP_MAX=
JITO_ATTEMPTS=
ATA_RENT_USD=0.5

# --- alerts --------------------------------------------------------------------------------------------------------
TELEGRAM_CONFIG=
NOTIFY_EXEC=
NOTIFY_STATE=
HEARTBEAT_FILE=

# --- web build (Next.js; inlined at build time) -------------------------------------------------------------------
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_API_BASE=/api
API_ORIGIN=http://127.0.0.1:5041
